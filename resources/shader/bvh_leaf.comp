#version 430

//按排序结果写入叶子节点(每个叶子一个三角形),并把节点数据写成遍历着色器期望的12个float布局
//布局: [left, right, 0, n, index, 0, AA.xyz, BB.xyz]
layout(local_size_x = 256) in;

layout(std430, binding = 1) readonly buffer Triangles {
    float tri[];
};

layout(std430, binding = 2) readonly buffer Keys {
    uvec2 keys[];
};

layout(std430, binding = 3) writeonly buffer Nodes {
    float node[];
};

uniform int triCount;
uniform int paddedCount;
uniform int leafBase; //叶子层的第一个节点下标(等于补齐后的叶子数)

const float HUGE = 1e30;

void main() {
    uint s = gl_GlobalInvocationID.x;
    if (s >= uint(paddedCount)) return;

    int id = leafBase + int(s);
    int base = id * 12;

    if (int(s) < triCount) {
        uint t = keys[s].y;
        int tb = int(t) * 27;
        vec3 a = vec3(tri[tb + 0], tri[tb + 1], tri[tb + 2]);
        vec3 b = vec3(tri[tb + 3], tri[tb + 4], tri[tb + 5]);
        vec3 c = vec3(tri[tb + 6], tri[tb + 7], tri[tb + 8]);
        vec3 lo = min(a, min(b, c));
        vec3 hi = max(a, max(b, c));

        node[base + 0] = 0.0;
        node[base + 1] = 0.0;
        node[base + 2] = 0.0;
        node[base + 3] = 1.0; //n
        node[base + 4] = float(t); //index
        node[base + 5] = 0.0;
        node[base + 6] = lo.x;
        node[base + 7] = lo.y;
        node[base + 8] = lo.z;
        node[base + 9] = hi.x;
        node[base + 10] = hi.y;
        node[base + 11] = hi.z;
    }
    else {
        //补齐用的空叶子:空包围盒,遍历时会被剪枝
        node[base + 0] = 0.0;
        node[base + 1] = 0.0;
        node[base + 2] = 0.0;
        node[base + 3] = 0.0;
        node[base + 4] = 0.0;
        node[base + 5] = 0.0;
        node[base + 6] = HUGE;
        node[base + 7] = HUGE;
        node[base + 8] = HUGE;
        node[base + 9] = -HUGE;
        node[base + 10] = -HUGE;
        node[base + 11] = -HUGE;
    }
}
